---
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { Code } from '@astrojs/starlight/components';
import { getLabels } from '../lib/labels';

interface Props {
	file: string;
	course?: string;
}

const labels = getLabels(Astro.currentLocale);
const { file, course = 'automation-ai' } = Astro.props;

const root = join(process.cwd(), 'courses', course, 'examples');
const code = readFileSync(join(root, file), 'utf8');
const outputPath = join(root, '__outputs__', `${file}.txt`);
const lang = file.endsWith('.py')
	? 'python'
	: file.endsWith('.toml')
		? 'toml'
		: 'text';
const output = existsSync(outputPath) ? readFileSync(outputPath, 'utf8') : null;
---

<div class="example">
	<Code code={code} lang={lang} title={file} />
	{output !== null && (
		<>
			<p class="output-label">{labels.example.output}</p>
			<Code code={output.trimEnd() || labels.example.noOutput} lang="text" />
		</>
	)}
</div>

<style>
	.example {
		margin: 1.5rem 0;
	}

	.output-label {
		margin: 0.75rem 0 0.25rem;
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
</style>
