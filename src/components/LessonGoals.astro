---
interface Props {
	title?: string;
}

const { title = 'Learning goals' } = Astro.props;
---

<section class="lesson-goals">
	<h3>{title}</h3>
	<ul>
		<slot />
	</ul>
</section>

<style>
	.lesson-goals {
		background: var(--sl-color-accent-low);
		border-left: 4px solid var(--sl-color-accent);
		padding: 1rem;
		margin: 1rem 0;
		border-radius: var(--sl-border-radius);
	}

	.lesson-goals h3 {
		margin-top: 0;
		margin-bottom: 0.5rem;
		color: var(--sl-color-accent);
	}

	.lesson-goals ul {
		margin: 0;
		padding-left: 1.5rem;
	}

	.lesson-goals li {
		margin-bottom: 0.5rem;
	}
</style>
