---
import { getLabels } from '../lib/labels';

const labels = getLabels(Astro.currentLocale);
---

<section class="lesson-goals">
	<p class="title">{labels.lessonGoals.title}</p>
	<slot />
</section>

<style>
	.lesson-goals {
		background: var(--sl-color-accent-low);
		border-inline-start: 4px solid var(--sl-color-accent);
		padding: 1rem 1.25rem;
		margin: 1.5rem 0;
		border-radius: var(--sl-border-radius);
	}

	.title {
		margin: 0 0 0.5rem;
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}

	.lesson-goals :global(ul) {
		margin: 0;
	}
</style>
