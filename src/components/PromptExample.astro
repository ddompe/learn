---
import { getLabels } from '../lib/labels';

const labels = getLabels(Astro.currentLocale);
---

<div class="prompt-example">
	<section class="block lousy">
		<p class="label">
			<span aria-hidden="true">✗</span> {labels.prompt.lousy}
		</p>
		<div class="prompt">
			<slot name="lousy" />
		</div>
	</section>
	<section class="block">
		<p class="label">{labels.prompt.whatGoesWrong}</p>
		<slot name="whatGoesWrong" />
	</section>
	<section class="block good">
		<p class="label">
			<span aria-hidden="true">✓</span> {labels.prompt.good}
		</p>
		<div class="prompt">
			<slot name="good" />
		</div>
	</section>
	<section class="block">
		<p class="label">{labels.prompt.whyItWorks}</p>
		<slot name="whyItWorks" />
	</section>
	<section class="block">
		<p class="label">{labels.prompt.check}</p>
		<slot name="check" />
	</section>
</div>

<style>
	.prompt-example {
		margin: 1.5rem 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--sl-border-radius);
		overflow: hidden;
	}

	.block {
		min-width: 0;
		padding: 0.75rem 1.25rem;
		border-top: 1px solid var(--sl-color-gray-5);
	}

	.block:first-child {
		border-top: none;
	}

	.label {
		margin: 0 0 0.25rem;
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}

	.lousy {
		background: var(--sl-color-red-low);
		border-inline-start: 4px solid var(--sl-color-red);
	}

	.good {
		background: var(--sl-color-green-low);
		border-inline-start: 4px solid var(--sl-color-green);
	}

	.lousy .label {
		color: var(--sl-color-red-high);
	}

	.good .label {
		color: var(--sl-color-green-high);
	}

	.prompt {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.block :global(> :last-child),
	.prompt :global(> :last-child) {
		margin-bottom: 0;
	}
</style>
