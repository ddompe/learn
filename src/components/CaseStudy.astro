---
import { getLabels } from '../lib/labels';

interface Props {
	title?: string;
}

const labels = getLabels(Astro.currentLocale);
const { title = labels.caseStudy.title } = Astro.props;
---

<aside class="case-study">
	<p class="title">☕ {title}</p>
	<slot />
</aside>

<style>
	.case-study {
		background: var(--sl-color-orange-low);
		border-inline-start: 4px solid var(--sl-color-orange);
		padding: 1rem 1.25rem;
		margin: 1.5rem 0;
		border-radius: var(--sl-border-radius);
	}

	.title {
		margin: 0 0 0.5rem;
		font-weight: 600;
		color: var(--sl-color-orange-high);
	}

	.case-study :global(> :last-child) {
		margin-bottom: 0;
	}
</style>
