---
import { getLabels } from '../lib/labels';

interface Props {
	question: string;
}

const labels = getLabels(Astro.currentLocale);
const { question } = Astro.props;
---

<div class="checkpoint">
	<p class="question">
		<strong>{labels.checkpoint.question}:</strong> {question}
	</p>
	<details>
		<summary>{labels.checkpoint.showAnswer}</summary>
		<div class="answer">
			<slot />
		</div>
	</details>
</div>

<style>
	.checkpoint {
		border: 1px solid var(--sl-color-gray-5);
		border-inline-start: 4px solid var(--sl-color-purple);
		background: var(--sl-color-purple-low);
		border-radius: var(--sl-border-radius);
		padding: 1rem 1.25rem;
		margin: 1.5rem 0;
	}

	.question {
		margin: 0 0 0.75rem;
	}

	summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--sl-color-purple-high);
	}

	.answer {
		margin-top: 0.75rem;
	}

	.answer :global(> :last-child) {
		margin-bottom: 0;
	}
</style>
